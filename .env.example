# coworkOS Environment Variables
# Copy this file to .env and fill in your values

# ─── LLM Provider ─────────────────────────────────────
# Supported: anthropic, openai, ollama
LLM_PROVIDER=anthropic

# ─── LLM Model ────────────────────────────────────────
LLM_MODEL=claude-haiku-4-5-20251001

# ─── API Keys ─────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# ─── Browser Settings ─────────────────────────────────
# Run browser in headless mode (true/false)
BROWSER_HEADLESS=true

# Directory to store persistent browser profiles
BROWSER_PROFILE_DIR=./profiles

# ─── CDP: Connect to your existing browser ────────────
# Instead of launching a new browser, attach to a running Chrome/Edge.
# This lets the agent work in your real browser with your logins and cookies.
#
# STEP 1 — Launch Chrome/Edge with remote debugging enabled:
#
#   Windows — easiest: run the ready-made script at the repo root:
#     scripts\start_chrome_windows.bat
#     — or —
#     powershell -ExecutionPolicy Bypass -File scripts\start_chrome_windows.ps1
#
#   Windows (manual, cmd):
#     "C:\Program Files\Google\Chrome\Application\chrome.exe" ^
#       --remote-debugging-port=9222 --no-first-run --no-default-browser-check
#
#   macOS:
#     /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
#       --remote-debugging-port=9222 --no-first-run
#
#   Linux:
#     google-chrome --remote-debugging-port=9222 --no-first-run
#
# STEP 2 — Set BROWSER_CDP_URL below:
#   Chrome on Windows, coworkOS in WSL2 (use host IP from: ip route show | grep default):
#     BROWSER_CDP_URL=http://172.24.80.1:9222
#   Chrome and coworkOS on the same machine:
#     BROWSER_CDP_URL=http://localhost:9222
#   Chrome on Windows host, coworkOS in Docker:
#     BROWSER_CDP_URL=http://host.docker.internal:9222
#
# STEP 3 — Verify Chrome is reachable before running the agent:
#     curl http://localhost:9222/json/version
#
# Leave empty to launch a new isolated Playwright browser (default).
BROWSER_CDP_URL=

# ─── Agent Settings ───────────────────────────────────
# Maximum number of steps per task
MAX_STEPS=50

# Token budget for message history (triggers compaction)
TOKEN_BUDGET=100000

# ─── Privacy & Security ───────────────────────────────
# Privacy mode: normal | strict (strict = no screenshots saved to disk)
PRIVACY_MODE=normal

# ─── Logging ──────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Storage ──────────────────────────────────────────
# Directory for application data (SQLite DB, etc.)
DATA_DIR=./data

# ─── API Server ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
