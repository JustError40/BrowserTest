# coworkOS Environment Variables
# Copy this file to .env and fill in your values

# ─── LLM Provider ─────────────────────────────────────
# Supported: anthropic, openai, ollama
LLM_PROVIDER=anthropic

# ─── LLM Model ────────────────────────────────────────
LLM_MODEL=claude-haiku-4-5-20251001

# ─── API Keys ─────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=

# ─── Browser Settings ─────────────────────────────────
# Run browser in headless mode (true/false)
BROWSER_HEADLESS=true

# Directory to store persistent browser profiles
BROWSER_PROFILE_DIR=./profiles

# ─── Agent Settings ───────────────────────────────────
# Maximum number of steps per task
MAX_STEPS=50

# Token budget for message history (triggers compaction)
TOKEN_BUDGET=100000

# ─── Privacy & Security ───────────────────────────────
# Privacy mode: normal | strict (strict = no screenshots saved to disk)
PRIVACY_MODE=normal

# ─── Logging ──────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Storage ──────────────────────────────────────────
# Directory for application data (SQLite DB, etc.)
DATA_DIR=./data

# ─── API Server ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
